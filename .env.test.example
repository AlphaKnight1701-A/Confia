# Copy to .env.test.local; test runner explicitly loads this file.
PORT=3000
CONFIA_PUBLIC_BASE_URL=http://localhost:3000
CONFIA_MCP_PATH=/mcp
CONFIA_MCP_AUTH_MODE=none
CONFIA_DATA_SOURCE=demo
CONFIA_CATALOG_PATH=./tests/fixtures/demo-products.json
CONFIA_DEFAULT_LOCALE=en
CONFIA_LOG_LEVEL=error
# Reject outside test execution. Never freeze a deployed catalog's clock.
CONFIA_TEST_NOW=2026-09-30T12:00:00.000Z
