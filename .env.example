# Planned Node.js MCP configuration. Copy to .env.local.
# The future server must load this explicitly; no Next.js env loader is present.
PORT=3000
CONFIA_PUBLIC_BASE_URL=http://localhost:3000
CONFIA_MCP_PATH=/mcp
# MVP: no-auth is allowed only with public synthetic read-only demo data.
CONFIA_MCP_AUTH_MODE=none
CONFIA_DATA_SOURCE=demo
CONFIA_CATALOG_PATH=./data/demo-products.json
CONFIA_DEFAULT_LOCALE=en
CONFIA_LOG_LEVEL=info
# No OpenAI API key/model or database credentials are needed for this architecture.
