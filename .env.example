# Planned configuration; copy to .env.local. Never commit real credentials.
NEXT_PUBLIC_APP_URL=http://localhost:3000
CONFIA_DATA_SOURCE=demo
CONFIA_DEMO_WRITES=false
CONFIA_DEFAULT_LOCALE=en
CONFIA_AI_ENABLED=false
CONFIA_LOG_LEVEL=info
# Required only when AI is enabled; server-only.
OPENAI_API_KEY=
OPENAI_MODEL=
# Required only for Supabase mode.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional privileged worker only; never use for user requests.
SUPABASE_SERVICE_ROLE_KEY=
